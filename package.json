{
  "name": "knit-private-domain-platform",
  "version": "0.1.0",
  "private": true,
  "description": "私域 + H5 + Web 管理後台的毛線織女交易平台 MVP monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin-web",
    "dev:api": "npm run start:dev -w apps/api",
    "build": "npm run build -w @knit/shared && npm run build -w @knit/ui && npm run build -w apps-api && npm run build -w apps-web && npm run build -w apps-admin-web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.12.12",
    "globals": "^17.6.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
